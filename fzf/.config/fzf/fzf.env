# Find dot directories and files (prefer fd, then rg, and fall back to find)
if command -v fd > /dev/null 2>&1; then
   export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
elif command -v rg > /dev/null 2>&1; then
   export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!**/ .git/*"'
else
   export FZF_DEFAULT_COMMAND='find . -type f -o -type l'
fi
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Preview file content when using CTRL-T (Requires 'bat' installed for syntax highlighting)
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {}'"

# Customize CTRL-R command history to show a clean layout and toggle details
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:wrap --bind 'ctrl-/:toggle-preview'"

# Preview directory tree layout when using ALT-C (Requires 'eza' or 'tree')
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

